+        def instructions(self, task, *, include_requirement_document=False):
+            self.include_requirement_document.append(include_requirement_document)
+            return "MAIN_AND_REFERENCES" if include_requirement_document else "REFERENCES_ONLY"
+
+    access = DocumentAccess()
