+@pytest.mark.asyncio
+@pytest.mark.parametrize("state", [AeolusState.CODING, AeolusState.RECODING])
+async def test_coding_instructions_allow_primary_document(state):
+    task = _task(
+        state=state,
+        requirement_url="https://bytedance.larkoffice.com/docx/MainDoc",
+    )
+    service, tokens, _ = _service(task)
+
+    instructions = service.instructions(task, include_requirement_document=True)
+    markdown = await service.read_markdown(
+        task_id=task.task_id,
+        capability=service.issue(task),
+        url=task.requirement_url,
+    )
+
+    assert "MainDoc" in instructions
+    assert "DocToken2" in instructions
+    assert "主需求文档和下列引用文档" in instructions
+    assert "需要核对原文时可以使用此工具" in instructions
+    assert "不要输出、解释或记录能力凭证" in instructions
+    assert "不要通过代理自行获取凭据" in instructions
+    assert "代理不可用或权限不足时" in instructions
+    assert "把该文档和受影响的核对项写入 `unresolved_items`" in instructions
+    assert "不要读取列表外的文档" in instructions
+
+    if state == AeolusState.RECODING:
+        prompt = build_feedback_prompt("请补测试", instructions)
+    else:
+        prompt = build_coding_prompt(
+            requirement_url=task.requirement_url,
+            evaluation_summary="信息充分",
+            branch="aeolus/ai-node/task-1",
+            document_access_instructions=instructions,
+        )
+    assert instructions in prompt
+    assert "## 飞书文档（读取时机）" in prompt
+    assert "按需读取相关文档或章节" in prompt
+    assert "无需在任务开始时自动读取主需求文档或遍历引用链接" in prompt
+    assert "skill" not in prompt
+    assert "不要为了确认权限而预读文档" in prompt
+    assert "lark_authorization_required" in prompt
+    for forbidden in (
+        "不要尝试登录", "所有文档读取必须通过此代理", "必读", "编码前必须读",
+        "lark-cli docs +fetch", "--as bot", "--as user", "131006", "3380004", "99991672",
+    ):
+        assert forbidden not in instructions
+        assert forbidden not in prompt
