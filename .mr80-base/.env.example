# 稳定的 App/Plugin/Agent ID、接口地址、PSM、KMS alias、模板与运行默认值
# 统一维护在 src/conciliator/config.py；仅需覆盖差异项，无需重复填写。
# Resolve、Coding、Devbox、PPE 和飞书通知始终启用。

ENV=dev
LOG_LEVEL=INFO
PORT0=8000
# 生产镜像安装 bytedlogger 后自动接入 Argos StreamLog；本地无 SDK 时自动降级为仅 stdout
ARGOS_LOG_ENABLED=true

# ── 本地数据库（生产使用 Settings 中的 bytedmysql 服务发现配置）──
MYSQL_DSN=mysql+pymysql://root:root@127.0.0.1:3306/aeolus_govern

# ── ByteCloud ──
# ENV=dev 读取配套的本地 AK/SK；两项均支持 .env 和进程环境变量。
BYTECLOUD_AK=
BYTECLOUD_SK=
# staging/prod 从同一个 KMS Secret 读取 {"ak":"...","sk":"..."}，整对轮转。
# KMS_SECRET_BYTECLOUD_CREDENTIALS_ALIAS=conciliator/credentials/bytecloud_credentials

# ── 本地凭据（ENV=dev；勿提交真实值）──
NEXTCODE_APP_SECRET=
NEXTCODE_WEBHOOK_SECRET=

# ── 本地飞书测试应用 ──
# 与线上使用不同 App，防止同一 App 的长连接把回调随机发给本地或线上实例。
# ID 与 Secret 必须属于同一个测试应用；支持 .env 和进程环境变量。
# ENV=dev + websocket 拒绝沿用代码中的生产 App ID。
LARK_APP_ID=
LARK_APP_SECRET=

# ── 本地 Meegle 测试节点（ID、Secret、Token 必须属于同一个插件）──
# 代码默认 ID 为正式插件 MII_6AED80FF53004C14；dev 显式覆盖为原测试插件。
MEEGLE_PLUGIN_ID=MII_6AAF4159C3C0CCDB
MEEGLE_PLUGIN_SECRET=
MEEGLE_WEBHOOK_TOKEN=
# 两项本地凭据支持 .env 和进程环境变量，仅 ENV=dev 使用；staging/prod 始终读取 KMS。

# ── 飞书用户授权回调 ──
# 用户在飞书同意授权后回到本服务的地址，用于按操作者权限读取需求文档。
# 应用无权读取文档时，可让操作者授权；授权不会扩大操作者自身的文档权限。
# 测试 App 必须登记浏览器可访问的本地服务回调地址，不能沿用线上回调。
# 配置变更后重启服务。
# 启用用户授权时填写实际地址；留空关闭授权入口，仍可读取应用可访问的文档。
LARK_OAUTH_REDIRECT_URI=
# 如测试 App 无权向默认目录上传 Markdown，指定该 App 可访问的目录。
# LARK_MARKDOWN_FOLDER_TOKEN=<test-app-folder-token>

# ── 其他可选的环境差异 ──
# Trace Basic Auth：用户名到密码的 JSON 映射。
# TRACE_VIEWERS={"reader":"<password>"}

# ── 按需调整的运行参数 ──
# WORKER_CONCURRENCY=4
# WORKER_POLL_INTERVAL_SECONDS=5
# COCO_TASK_TIMEOUT_SECONDS=900
# MYSQL_POOL_SIZE=10
# MYSQL_POOL_MAX_OVERFLOW=20
BYTEDMETRICS_DEBUG=False
