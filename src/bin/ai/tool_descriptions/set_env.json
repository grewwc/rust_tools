{
  "name": "set_env",
  "description": "Set an environment variable in the current process's Context Manager. Child processes will inherit this context.",
  "parameters": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "description": "Environment variable name to set."
      },
      "value": {
        "type": "string",
        "description": "Value to assign."
      }
    },
    "required": [
      "key",
      "value"
    ]
  }
}
