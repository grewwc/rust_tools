{
  "name": "knowledge_search",
  "description": "Search saved knowledge by keywords (BM25 + lexical similarity).",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "Keywords to match."
      },
      "category": {
        "type": "string",
        "description": "Filter by category."
      },
      "limit": {
        "type": "integer",
        "description": "Max results (default: 10)."
      }
    },
    "required": [
      "query"
    ]
  },
  "groups": [
    "builtin",
    "knowledge"
  ]
}
