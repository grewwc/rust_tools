+        EvaluationResult(True, "信息充分", (), ()), document_access=access
+    )
+
+    await service.accept_event(_event())
+    await service.wait_for_idle()
+    assert access.include_requirement_document and not any(access.include_requirement_document)
+    assert runner.evaluation_inputs[-1][1] == "REFERENCES_ONLY"
+
+    await service.confirm_evaluation("idem-1", "evaluation-confirm")
+    await service.wait_for_idle()
+
